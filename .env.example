# ── שרת ──
PORT=3009

# מתג השבתה ראשי. כל ערך שאינו "yes" — הודעות נכנסות לא מועברות לבקאנד.
# החיבור לווצאפ והסריקה ממשיכים לעבוד, כך שאפשר לחבר בלי להתחיל לקלוט.
RUNNING=yes

# ── היעד: ה-webhook של קליטת ההזמנות ב-sweet-backend ──
# הכתובת המלאה. הפורט מתאים ל-PORT שב-.env של sweet-backend (3050).
SWEET_ORDERS_WEBHOOK_URL=http://127.0.0.1:3050/api/incoming-orders/whatsapp

# חייב להיות זהה ל-SWEET_WHATSAPP_API_KEY שב-.env של sweet-backend.
# ליצירה: openssl rand -hex 32
#
# שים לב: זה **אינו** KIRSHNER_WHATSAPP_API_KEY. האחרון הוא סוד של השרת של
# קירשנר, שהבקאנד עדיין פונה אליו לשתי פעולות אחרות.
SWEET_WHATSAPP_API_KEY=

# חייב להיות זהה ל-JWT_SECRET שב-.env של sweet-backend.
# בזכותו הדשבורד קורא ל-/status ול-/logout עם טוקן האדמין שלו, בלי שה-API key
# יישב ב-bundle של הדפדפן.
JWT_SECRET=

# ── CORS ──
# רשימה מופרדת בפסיקים של המקורות שמורשים להתחבר (כתובת האדמין).
# ריק = חסום להכל. אין להשתמש ב-* בפרודקשן.
CORS_ALLOWED_ORIGINS=http://localhost:4102,https://admin.your-domain.co.il

# ── קבצים מצורפים ──
# מעל הגודל הזה קובץ לא יורד — רק נרשם. תואם ל-GMAIL_MAX_ATTACHMENT_BYTES בבקאנד.
MAX_ATTACHMENT_BYTES=5242880

# מקסימום קבצים שמועברים מהודעה אחת. תואם ל-WHATSAPP_MAX_ATTACHMENTS בבקאנד.
MAX_ATTACHMENTS_PER_MESSAGE=5

# ── רמת הלוג של Baileys: silent | error | warn | info | debug ──
BAILEYS_LOG_LEVEL=warn
